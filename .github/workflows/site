name: Preview Static Site

on:
  push:
  workflow_dispatch:

jobs:
  preview:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # 1. Create (or use existing) static HTML
      - name: Build site
        run: |
          mkdir -p public
          cat > public/index.html <<'EOF'
          <!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <title>Preview</title>
            <style>
              body { font-family: system-ui; display: grid; place-items: center;
                     height: 100vh; margin: 0; background: #0d1117; color: #e6edf3; }
              h1 { font-size: 3rem; }
            </style>
          </head>
          <body>
            <div>
              <h1>🚀 Hello from GitHub Actions</h1>
              <p>Commit: ${{ github.sha }}</p>
            </div>
          </body>
          </html>
          EOF

      # 2. Serve the static files on port 8000
      - name: Start web server
        run: |
          cd public
          python3 -m http.server 8000 > /tmp/server.log 2>&1 &
          sleep 2
          curl -sf http://localhost:8000 > /dev/null && echo "Server is up"

      # 3. Download cloudflared and open a public tunnel
      - name: Start Cloudflare tunnel
        run: |
          curl -L -o cloudflared \
            https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
          chmod +x cloudflared

          ./cloudflared tunnel --url http://localhost:8000 --no-autoupdate \
            > /tmp/tunnel.log 2>&1 &

          # Wait for the URL to appear (up to ~30s)
          for i in $(seq 1 30); do
            URL=$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' /tmp/tunnel.log | head -1)
            [ -n "$URL" ] && break
            sleep 1
          done

          if [ -z "$URL" ]; then
            echo "Failed to get tunnel URL"; cat /tmp/tunnel.log; exit 1
          fi

          echo "URL=$URL" >> "$GITHUB_ENV"
          echo "### 🚀 Preview: $URL" >> "$GITHUB_STEP_SUMMARY"
          echo "Preview URL: $URL"

      # 4. Keep the job (and URL) alive for N minutes
      - name: Keep alive
        run: |
          echo "URL will be live for 10 minutes: $URL"
          sleep 600
